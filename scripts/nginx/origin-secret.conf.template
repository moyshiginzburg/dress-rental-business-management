# =============================================================================
# dress-origin.conf - only the Vercel site may talk to the backend
#
# Final purpose: the VPS backend must be reachable only through the Vercel site, so a
# caller cannot reach the API directly, forge the visitor IP, or bypass IP-based limits.
#
# Method of operation:
#   Vercel's middleware (frontend/src/middleware.ts) adds the header X-Origin-Secret to
#   every /api and /uploads request it proxies. This file (included from the http context
#   through conf.d) turns that into variables used by sites-available/dress-backend:
#     $origin_ok          1 when the header equals the shared secret, else 0
#     $origin_gas_ok      1 when the header X-Gas-Log-Secret equals the Google Apps Script secret
#     $origin_deny        1 when the request must be refused (HTTP 444, connection dropped):
#                      * /api/apps-script-logs[/batch]: only with X-Gas-Log-Secret (the Apps
#                        Script posts there directly), and NOT even the Vercel site may use it
#                      * /api/health: always allowed (no data)
#                      * everything else: only with the Vercel origin secret
#     $origin_client_ip   the visitor IP handed to the backend as X-Forwarded-For / X-Real-IP
#
# Install: scripts/setup-new-server.sh copies this template to
#   /etc/nginx/conf.d/dress-origin.conf (root-only, 0640) replacing __ORIGIN_SECRET__ with the
#   values of ORIGIN_SECRET and GAS_LOG_SECRET from local_data/.env. ORIGIN_SECRET must also
#   be the ORIGIN_SECRET environment variable of the Vercel project; GAS_LOG_SECRET must also
#   be in apps_script/Secrets.js (pushed with clasp). To rotate: change all copies, redeploy
#   the Vercel project / the Apps Script web app, then reload nginx.
# Emergency rollback (frontend down because of this): in sites-available/dress-backend
#   remove the `if ($origin_deny) { return 444; }` block, `nginx -t && systemctl reload nginx`.
# =============================================================================
map_hash_bucket_size 128;

map $http_x_origin_secret $origin_ok {
    default 0;
    "__ORIGIN_SECRET__" 1;
}

# Google Apps Script log shipping has its own secret (apps_script/Secrets.js).
map $http_x_gas_log_secret $origin_gas_ok {
    default 0;
    "__GAS_LOG_SECRET__" 1;
}

# Path classes as single digits so that the decision below never mixes in user text.
map $uri $origin_gas_path {
    default 0;
    "~*^/api/apps-script-logs(/batch)?/?$" 1;
}

map $uri $origin_health_path {
    default 0;
    "/api/health" 1;
}

# Decision key = gas_path, origin_ok, gas_ok, health_path (four digits). First match wins.
map "$origin_gas_path$origin_ok$origin_gas_ok$origin_health_path" $origin_deny {
    default 1;
    "~^1.1.$" 0;   # Apps Script log path WITH the Apps Script secret
    "~^1"     1;   # Apps Script log path without it: refused, even through Vercel
    "~^01"    0;   # any other path coming through the Vercel site
    "~^0..1$" 0;   # /api/health
}

# Real visitor IP. Vercel puts it in X-Vercel-Proxied-For, which (tested) a visitor cannot
# forge, unlike X-Forwarded-For / X-Real-IP / X-Vercel-Forwarded-For, which Vercel sometimes
# passes through as the visitor typed them. Requests without the secret get their TCP peer.
map $http_x_vercel_proxied_for $origin_vercel_ip {
    default $http_x_vercel_proxied_for;
    "" $remote_addr;
}

map $origin_ok $origin_client_ip {
    1 $origin_vercel_ip;
    default $remote_addr;
}

# Observation / audit log: one line per request showing whether the secret matched.
log_format dress_origin '$time_iso8601 ok=$origin_ok gas=$origin_gas_ok deny=$origin_deny ra=$remote_addr ip=$origin_client_ip $request_method $uri $status';
