# ===========================================
# Dress Rental Business Management - Environment
# ===========================================
# Copy this file to local_data/.env and update the values.
# The backend loads from local_data/.env (configure.sh creates it automatically).

# Server Configuration
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000
# Interface the backend listens on. Default 127.0.0.1 (only nginx on the same machine can reach it).
# Set to 0.0.0.0 only if something on another machine must call the backend directly.
BIND_HOST=

# Public URL for agreement signing links sent to customers via WhatsApp.
# On VPS with Tailscale: set to your Tailscale Funnel URL (e.g. https://my-vps.tail1234.ts.net)
# Falls back to the hardcoded Vercel URL if not set.
PUBLIC_FRONTEND_URL=

# Database Configuration (default: local_data/backend_data/business.db)
DATABASE_PATH=

# Authentication
# Generate a secure secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-this-to-a-secure-random-string
JWT_EXPIRES_IN=7d

# Business Information (displayed in emails and agreements)
BUSINESS_NAME=Your Business Name
BUSINESS_EMAIL=your-email@example.com
BUSINESS_PHONE=YOUR_PHONE_NUMBER
BUSINESS_ADDRESS=YOUR_BUSINESS_ADDRESS
# Optional: the business's own bank account (where customers transfer money).
# The AI that reads payment screenshots is told this is the RECIPIENT account, so it never
# reports it as the payer's bank details. Leave empty if not needed.
BUSINESS_BANK_NUMBER=
BUSINESS_BANK_BRANCH=
BUSINESS_BANK_ACCOUNT=

# Apps Script Web App URL (REQUIRED)
# All email sending and integration goes through HTTPS POST to this URL.
# This bypasses SMTP ports completely.
# Deploy your Apps Script as a Web App and paste the URL here.
# Example: https://script.google.com/macros/s/AKfycb.../exec
APPS_SCRIPT_WEB_APP_URL=

# Local Storage (synced with Google Drive via rclone or similar)
# This folder should be set up to auto-sync with Google Drive
LOCAL_SYNCED_FOLDER=/path/to/your/synced/folder

# Gemini AI (receipt extraction)
# Get API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Optional override (comma-separated). System auto-discovers available models and uses fallback.
# Example: gemini-3-pro-preview,gemini-3-flash-preview,gemini-2.5-pro,gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.0-flash,gemini-2.0-flash-lite
GEMINI_MODEL_CANDIDATES=

# SmartInvoice (optional automatic receipts for income). Notes: docs/SMARTINVOICE.md
# sk_live_... = real, legally numbered receipts. An sk_test_... key makes every receipt fail with an alert.
# If empty, the receipt feature is hidden in the UI and no receipts are issued.
SMARTINVOICE_API_KEY=
# Optional override of the API base URL
SMARTINVOICE_BASE_URL=

# Web Push notifications (optional; dress return reminders on the owner's devices)
# Generate the keys with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:your-email@example.com

# Telegram alerts (optional but recommended)
# Bot token from @BotFather. Chat ID of the group the bot is a member of.
# Used for: real-time error and login alerts, receipt alerts, daily DB backup, daily security summary.
# If not set, all Telegram notifications are silently skipped.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Shared secrets (generated by scripts/setup-new-server.sh on a new server)
# ORIGIN_SECRET: nginx accepts backend requests only with this value in the X-Origin-Secret header.
#   Set the SAME value as the ORIGIN_SECRET environment variable of the Vercel project.
# GAS_LOG_SECRET: the Apps Script sends it (apps_script/Secrets.js) when it posts its logs to
#   /api/apps-script-logs. Without it that endpoint refuses all log lines.
ORIGIN_SECRET=
GAS_LOG_SECRET=

# Backup Configuration (used by rclone scripts)
RCLONE_REMOTE=gdrive
DRIVE_PATH=YOUR_REPO_NAME
